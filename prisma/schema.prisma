generator client {
  provider = "prisma-client-js"
}

generator client_python {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = "5"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String        @unique @db.VarChar(50)
  role         String?       @default("USER") @db.VarChar(20)
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  explanations Explanation[]

  @@map("users")
}

model Exam {
  id          String    @id @db.VarChar(20)
  name        String    @db.VarChar(100)
  country     String?   @default("LK") @db.VarChar(10)
  description String?
  subjects    Subject[]

  @@map("exams")
}

model Subject {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId String?       @map("exam_id") @db.VarChar(20)
  code   String?       @db.VarChar(10)
  name   String        @db.VarChar(100)
  stream String?       @db.VarChar(50)
  papers Paper[]
  units  SubjectUnit[]
  exam   Exam?         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, code])
  @@map("subjects")
}

model SubjectUnit {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId  String?        @map("subject_id") @db.Uuid
  unitNumber Int            @map("unit_number")
  nameEn     String?        @map("name_en") @db.VarChar(255)
  nameSi     String?        @map("name_si") @db.VarChar(255)
  nameTa     String?        @map("name_ta") @db.VarChar(255)
  questions  QuestionUnit[]
  subject    Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, unitNumber])
  @@map("subject_units")
}

model Paper {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId        String?    @map("subject_id") @db.Uuid
  year             Int
  part             String     @db.VarChar(50)
  type             String     @db.VarChar(20)
  timeLimitMinutes Int?       @map("time_limit_minutes")
  subject          Subject?   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions        Question[]
  paperData        PaperData?

  @@unique([subjectId, year, part])
  @@index([subjectId], map: "idx_papers_subject_id")
  @@map("papers")
}

model PaperData {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paperId          String            @unique @map("paper_id") @db.Uuid
  boundingBoxes    Json?             @map("bounding_boxes")
  curationMarkdown String?           @map("curation_markdown")
  imagesDict       Json?             @map("images_dict")
  pdfUrl           String?           @map("pdf_url")
  submissions      PaperSubmission[]
  paper            Paper             @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("paper_data")
}

model Question {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paperId           String?                @map("paper_id") @db.Uuid
  parentQuestionId  String?                @map("parent_question_id") @db.Uuid
  label             String                 @db.VarChar(50)
  sortOrder         Int                    @default(0) @map("sort_order")
  type              String                 @db.VarChar(50)
  difficulty        Int?
  correctAnswerKeys String[]               @map("correct_answer_keys")
  marksAllocated    Int?                   @map("marks_allocated")
  createdAt         DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  explanations      Explanation[]
  localizations     QuestionLocalization[]
  units             QuestionUnit[]
  paper             Paper?                 @relation(fields: [paperId], references: [id], onDelete: Cascade)
  parentQuestion    Question?              @relation("QuestionHierarchy", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  childQuestions    Question[]             @relation("QuestionHierarchy")

  @@index([paperId], map: "idx_questions_paper_id")
  @@index([parentQuestionId], map: "idx_questions_parent_id")
  @@map("questions")
}

model QuestionUnit {
  questionId String      @map("question_id") @db.Uuid
  unitId     String      @map("unit_id") @db.Uuid
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  unit       SubjectUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([questionId, unitId])
  @@map("question_units")
}

model QuestionLocalization {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId   String?   @map("question_id") @db.Uuid
  languageCode String    @map("language_code") @db.VarChar(2)
  promptText   String?   @map("prompt_text")
  promptImages Json?     @default("[]") @map("prompt_images")
  options      Json?
  question     Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, languageCode])
  @@index([questionId], map: "idx_localizations_question_id")
  @@map("question_localizations")
}

model Explanation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId    String?   @map("question_id") @db.Uuid
  authorId      String?   @map("author_id") @db.Uuid
  languageCode  String    @map("language_code") @db.VarChar(2)
  contentText   String    @map("content_text")
  contentImages Json?     @default("[]") @map("content_images")
  upvotes       Int?      @default(0)
  downvotes     Int?      @default(0)
  isVerified    Boolean?  @default(false) @map("is_verified")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  author        User?     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question      Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "idx_explanations_question_id")
  @@map("explanations")
}

model PaperSubmission {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             String     @db.VarChar(20)
  status           String     @db.VarChar(50)
  pdfUrl           String?    @map("pdf_url")
  paperDataId      String?    @map("paper_data_id") @db.Uuid
  submitterEmail   String?    @map("submitter_email") @db.VarChar(255)
  metadata         Json?
  rawMineruOutput  Json?      @map("raw_mineru_output")
  curationMarkdown String?    @map("curation_markdown")
  imagesDict       Json?      @map("images_dict")
  boundingBoxes    Json?      @map("bounding_boxes")
  createdAt        DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?  @default(now()) @map("updated_at") @db.Timestamptz(6)
  paperData        PaperData? @relation(fields: [paperDataId], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_paper_submissions_status")
  @@map("paper_submissions")
}
